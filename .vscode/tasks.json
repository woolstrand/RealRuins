{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug (1.6)",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "Source/RealRuins.csproj",
                "/p:Configuration=Debug",
                "/p:Platform=AnyCPU",
                "/t:Build",
                "/nologo",
                "/v:minimal"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "windows": {
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
                }
            }
        },
        {
            "label": "Build Release (1.6)",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "Source/RealRuins.csproj",
                "/p:Configuration=Release",
                "/p:Platform=AnyCPU",
                "/t:Build",
                "/nologo",
                "/v:minimal"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "windows": {
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
                }
            }
        },
        {
            "label": "Build and Copy to RimWorld (Debug)",
            "dependsOn": "Build Debug (1.6)",
            "type": "shell",
            "command": "zsh postbuild.sh",
            "problemMatcher": [],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "windows": {
                "command": "postbuildwin.bat",
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
                }
            }
        },
        {
            "label": "Copy to RimWorld",
            "type": "shell",
            "command": "zsh postbuild.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "windows": {
                "command": "postbuildwin.bat",
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
                }
            }
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "Source/RealRuins.csproj",
                "/t:Clean",
                "/nologo",
                "/v:minimal"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "windows": {
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
                }
            }
        },
        {
            "label": "Launch RimWorld",
            "type": "shell",
            "command": "open",
            "args": [
                "-a",
                "${env:HOME}/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorldMac.app"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "windows": {
                "command": "cmd",
                "args": [
                    "/c",
                    "start",
                    "\"\"",
                    "F:\\SteamLibrary\\steamapps\\common\\RimWorld\\RimWorldWin64.exe"
                ],
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
                }
            },
            "isBackground": true
        },
        {
            "label": "Build, Copy, and Launch RimWorld",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build and Copy to RimWorld (Debug)",
                "Launch RimWorld"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
